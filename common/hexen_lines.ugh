include param_types

lineflag "two sided"   0x0004
lineflag "upper unpeg" 0x0008
lineflag "lower unpeg" 0x0010
lineflag "impassable"  0x0001
lineflag "block mons"  0x0002
lineflag "sound block" 0x0040

# Floors and lifts

special 20 f "Floor_Lower"              :tag! :speed  dist
special 21 f "Floor_LowerToLowest"      :tag! :speed
special 22 f "Floor_LowerToNearest"     :tag! :speed
special 23 f "Floor_RaiseByValue"       :tag! :speed  dist
special 24 f "Floor_RaiseToHighest"     :tag! :speed
special 25 f "Floor_RaiseToNearest"     :tag! :speed
special 28 f "Floor_RaiseAndCrush"      :tag! :speed  damage
special 35 f "Floor_RaiseByValueTimes8" :tag! :speed  dist_x8
special 36 f "Floor_LowerByValueTimes8" :tag! :speed  dist_x8
special 66 f "Floor_LowerInstant"       :tag! -  dist
special 67 f "Floor_RaiseInstant"       :tag! -  dist
special 68 f "Floor_MoveToValueTimes8"  :tag! :speed  height_x8  negate?
special 46 f "Floor_CrushStop"          :tag!

special 138 f "Floor_Waggle"        :tag! amp  speed  offset  time

special 62 g "Plat_DownWaitUpStay"  :tag! :speed  :delay
special 63 g "Plat_DownByValue"     :tag! :speed  :delay  dist
special 64 g "Plat_UpWaitDownStay"  :tag! :speed  :delay
special 65 g "Plat_UpByValue"       :tag! :speed  :delay  dist
special 60 g "Plat_PerpetualRaise"  :tag! :speed  :delay
special 61 g "Plat_Stop"            :tag!

special 26 q "Stairs_BuildDown"        :tag! :speed  dist:stepsize  delay  reset:delay
special 27 q "Stairs_BuildUp"          :tag! :speed  dist:stepsize  delay  reset:delay
special 31 q "Stairs_BuildDownSync"  :tag! :speed  dist:stepsize  reset:delay
special 32 q "Stairs_BuildUpSync"  :tag! :speed  dist:stepsize  reset:delay

# Ceiling and doors

special 40 c "Ceiling_LowerByValue"      :tag! :speed  dist
special 41 c "Ceiling_RaiseByValue"      :tag! :speed  dist
special 69 c "Ceiling_MoveToValueTimes8"  :tag! :speed  height_x8  negate?

special 42 c "Ceiling_CrushAndRaise"  :tag! :speed  damage
special 43 c "Ceiling_LowerAndCrush"         :tag! :speed  damage
special 45 c "Ceiling_CrushRaiseAndStay"     :tag! :speed  damage
special 44 c "Ceiling_CrushStop"      :tag!

special 10 d "Door_Close"   :tag! :speed
special 11 d "Door_Open"    :tag  :speed
special 12 d "Door_Raise"   :tag  :speed  :delay
special 13 d "Door_LockedRaise"  :tag  :speed  :delay  lock

# Lighting

special 110 l "Light_RaiseByValue"   :tag! light
special 111 l "Light_LowerByValue"   :tag! light
special 112 l "Light_ChangeToValue"     :tag! light
special 113 l "Light_Fade"    :tag! light  time
special 114 l "Light_Glow"    :tag! high  low  time
special 115 l "Light_Flicker" :tag! high  low
special 116 l "Light_Strobe"  :tag! high  low  hightime  lowtime

special 109 l "Force_Lightning"  mode:lightning

# Thing specials

special 72 t "ThrustThing"  :angle  dist
special 73 t "DamageThing"  damage

special 130 t "Thing_Activate"      :tid!
special 131 t "Thing_Deactivate"    :tid!
special 132 t "Thing_Remove"        :tid!
special 133 t "Thing_Destroy"       :tid!
special 134 t "Thing_Projectile"        :tid! type  :angle  :speed  vspeed
special 136 t "Thing_ProjectileGravity"  :tid! type  :angle  :speed  vspeed
special 135 t "Thing_Spawn"         :tid! type  :angle
special 137 t "Thing_SpawnNoFog" :tid! type  :angle

# Polyobj specials

special 90 p "Polyobj_OR_RotateLeft"  :po  :speed  :angle
special 91 p "Polyobj_OR_RotateRight"  :po  :speed  :angle
special 92 p "Polyobj_OR_Move"     :po  :speed  :angle  dist
special 93 p "Polyobj_OR_MoveTimes8"  :po  :speed  :angle  dist

# Miscellaneous

special 0  - "NOTHING"

special 29 e "Pillar_Build"  :tag! :speed  dist
special 30 e "Pillar_Open"   :tag! :speed  f_dist  c_dist
special 94 e "Pillar_BuildAndCrush"  :tag! :speed  dist  damage

special 95 e "Elevator_Lower"    :tag! :speed  dist
special 96 e "Elevator_Raise"    :tag! :speed  dist

special 80 k "ACS_Execute"       script  map  param1  param2  param3
special 83 k "ACS_LockedExecute" script  map  param1  param2  lock
special 81 k "ACS_Suspend"       script  map
special 82 k "ACS_Terminate"     script  map

special 121 - "Line_SetIdentification"  id_number:self_line_id

special 100 a "Scroll_Texture_Left"   :speed
special 101 a "Scroll_Texture_Right"  :speed
special 102 a "Scroll_Texture_Up"     :speed
special 103 a "Scroll_Texture_Down"   :speed

special 129 - "UsePuzzleItem"  item  script  param1  param2  param3
special 140 - "Sector_ChangeSound"  :tag  sound_seq
special 120 - "Radius_Quake"  intensity  duration  damrad  tremrad  :tid!

special 70 u "Teleport"          :tid!
special 71 u "Teleport_NoFog"  :tid!

special 74 x "Teleport_NewMap"  map  position
special 75 x "Teleport_EndGame"

